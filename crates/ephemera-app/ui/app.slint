// Ephemera — Slint application shell (Phase 2 & Phase 3: RAM Pane, Disk Pane).
//
// This window replaces the Tauri + React shell. The Rust side (`src/model.rs`)
// owns the state model and pushes these properties directly; there is no IPC and
// no serialization boundary — UI and core run in one process, one address space.
//
// The metadata-only discipline from CLAUDE.md survives the removal of that
// boundary by being enforced here in code: every property in this file carries
// metadata (names, sizes, mime types, origins, timestamps, statuses, tiers) and
// NEVER file byte content. The authoritative byte stores live exclusively inside
// `ephemera_core::state::AppState` (RAM heap buffer, vault folder, Postgres, GCS).

import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// State model structs.
// ---------------------------------------------------------------------------

export struct FileMeta {
    id: string,
    name: string,
    size: int,               // bytes — metadata, never the bytes themselves
    mime: string,
    created-at: string,      // formatted from FileMeta.created_at
    origin: string,          // "upload" | "stream" | "ram" | "disk"
    color: color,
    size-formatted: string,
}

export struct DiskFile {
    meta: FileMeta,
    persisted-at: string,    // formatted from DiskFile.persisted_at
}

export struct DbFile {
    meta: FileMeta,
    saved-at: string,        // formatted from DbFile.saved_at
}

export struct CloudFile {
    meta: FileMeta,
    saved-at: string,        // formatted from CloudFile.saved_at
    object-name: string,
}

export struct Metrics {
    ts: string,              // formatted from Metrics.ts
    ram-store-bytes: int,
    ram-cap: int,
    disk-store-bytes: int,
    disk-cap: int,
    db-store-bytes: int,
    db-cap: int,
    db-physical-bytes: int,
    cloud-store-bytes: int,
    cloud-cap: int,
    process-rss-bytes: int,
    process-count: int,
}

export struct DbStatus {
    connected: bool,
    logical-bytes: int,
    physical-bytes: int,
    cap: int,
    message: string,
}

export struct CloudStatus {
    connected: bool,
    bytes-used: int,
    cap: int,
    bucket: string,
    message: string,
}

export struct HistoryPoint {
    ram: int,               // ram_store_bytes at this tick
    rss: int,               // process_rss_bytes at this tick
}

export struct FileTableRow {
    name: string,
    size-formatted: string,
    tier: string,           // "RAM" | "Disk" | "Database" | "Cloud"
    mime: string,
}

export struct StreamReport {
    bytes-total: int,
    elapsed-ms: int,
    chunk-size: int,
    buffered-equivalent-peak-bytes: int,
    max-concurrent-streaming: int,
    max-concurrent-buffered: int,
    rss-baseline-bytes: int,
    rss-peak-bytes: int,
    rss-avg-bytes: int,
    rss-peak-delta-bytes: int,
    file-name: string,
    throughput-mb-s: string,
    bytes-total-formatted: string,
    chunk-size-formatted: string,
    elapsed-ms-formatted: string,
    buffered-equivalent-peak-bytes-formatted: string,
    rss-baseline-formatted: string,
    rss-peak-formatted: string,
    rss-avg-formatted: string,
    rss-peak-delta-formatted: string,
}

// ---------------------------------------------------------------------------
// Drag & Drop global state model.
// ---------------------------------------------------------------------------

export global DragState {
    in-out property <bool> active: false;
    in-out property <string> file-id: "";
    in-out property <string> file-name: "";
    in-out property <int> file-size: 0;
    in-out property <string> file-size-formatted: "";
    in-out property <color> file-color: #2a78d6;
    in-out property <string> source-tier: ""; // "ram" | "disk"
    in-out property <length> pointer-x: 0px;
    in-out property <length> pointer-y: 0px;

    in-out property <string> hover-target: "none"; // "none" | "ram" | "disk" | "db" | "cloud"
    in-out property <bool> hover-valid: false;
    in-out property <string> hover-reason: "";
}

// ---------------------------------------------------------------------------
// Design System & Theme global palette.
// ---------------------------------------------------------------------------

export global Theme {
    in-out property <bool> dark-mode: false;

    // Backgrounds & Surface levels
    out property <color> window-bg: dark-mode ? #181a1f : #f4f1ea;
    out property <color> card-bg: dark-mode ? #21252b : #fffdf8;
    out property <color> card-bg-hover: dark-mode ? #282c34 : #fbfaf5;
    out property <color> card-bg-dragged: dark-mode ? #2c313a : #f4f1ea;
    out property <color> dropzone-bg: dark-mode ? #282c34 : #f9f9f7;
    out property <color> dropzone-bg-hover: dark-mode ? #31353f : #f4f1ea;

    // Borders
    out property <color> border-light: dark-mode ? #31353f : #e1e0d9;
    out property <color> border-medium: dark-mode ? #3e4451 : #c3c2b7;
    out property <color> border-card: dark-mode ? #3e4451 : #c9c1b4;

    // Text colors
    out property <color> text-primary: dark-mode ? #e6e6e6 : #24303a;
    out property <color> text-secondary: dark-mode ? #abb2bf : #52514e;
    out property <color> text-muted: dark-mode ? #9da5b4 : #68747b;
    out property <color> text-faint: dark-mode ? #6c7280 : #898781;

    // Accents & Actions
    out property <color> primary: dark-mode ? #4c97f6 : #2a78d6;
    out property <color> primary-hover: dark-mode ? #3685e5 : #1f64b8;
    out property <color> danger: dark-mode ? #e05555 : #d03b3b;
    out property <color> danger-bg: dark-mode ? #3e2023 : #fde8e8;
    out property <color> danger-bg-hover: dark-mode ? #4e262a : #fce0e0;
    out property <color> success: dark-mode ? #1baf7a : #1baf7a;
    out property <color> success-bg: dark-mode ? #1e382b : #e8f5e9;
    out property <color> success-bg-hover: dark-mode ? #254736 : #c8e6c9;
    out property <color> handle-color: dark-mode ? #5c6370 : #b7b6ae;
    out property <color> sink-indicator: dark-mode ? #10b981 : #008300;
    out property <color> sink-text: dark-mode ? #e6e6e6 : #0b0b0b;

    // Charts & Sparklines
    out property <color> sparkline-ram: dark-mode ? #4c97f6 : #2a78d6;
    out property <color> sparkline-rss: dark-mode ? #ff7b42 : #eb6834;
    out property <color> note-text: dark-mode ? #7f848e : #9a9386;
}

// ---------------------------------------------------------------------------
// KPI row stat tile.
// ---------------------------------------------------------------------------

component StatTile inherits Rectangle {
    in property <string> tile-label;
    in property <string> tile-value;
    in property <string> tile-caption;

    background: Theme.card-bg;
    border-color: Theme.border-card;
    border-width: 1px;
    border-radius: 6px;

    VerticalBox {
        padding: 12px;
        spacing: 2px;
        Text {
            text: tile-label;
            color: Theme.text-muted;
            font-size: 12px;
        }
        Text {
            text: tile-value;
            color: Theme.text-primary;
            font-size: 22px;
            font-weight: 700;
        }
        Text {
            text: tile-caption;
            color: Theme.text-muted;
            font-size: 12px;
        }
    }
}

// ---------------------------------------------------------------------------
// ActionButton: compact button for FileCard items
// ---------------------------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    height: 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-medium : Theme.border-light;
    background: touch.has-hover ? Theme.border-light : Theme.card-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: danger ? Theme.danger : Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// PaneButton: button for pane actions
// ---------------------------------------------------------------------------

component PaneButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: primary ? Theme.primary : (touch.has-hover ? Theme.border-medium : Theme.border-light);
    background: primary ? (touch.has-hover ? Theme.primary-hover : Theme.primary) : (touch.has-hover ? Theme.border-light : Theme.card-bg);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: primary ? #ffffff : (danger ? Theme.danger : Theme.text-primary);
            font-size: 12px;
            font-weight: primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Meter: segmented store meter
// ---------------------------------------------------------------------------

component Meter inherits VerticalBox {
    in property <int> used: 0;
    in property <int> cap: 10485760;
    in property <string> used-text: "0 B";
    in property <string> cap-text: "10.0 MB";
    in property <[FileMeta]> segments;
    in property <int> preview-add-bytes: 0;
    in property <color> preview-add-color: Theme.success;

    spacing: 4px;
    padding: 0px;

    Rectangle {
        height: 22px;
        background: Theme.border-light;
        border-radius: 6px;
        clip: true;

        HorizontalLayout {
            padding: 0px;
            spacing: 2px;

            for seg in segments: Rectangle {
                horizontal-stretch: max(1, seg.size);
                background: seg.color;
            }

            if preview-add-bytes > 0: Rectangle {
                horizontal-stretch: max(1, preview-add-bytes);
                background: preview-add-color.transparentize(0.4);
                border-width: 1px;
                border-color: preview-add-color;
                border-radius: 2px;
            }

            if cap > (used + preview-add-bytes): Rectangle {
                horizontal-stretch: max(0, cap - (used + preview-add-bytes));
                background: transparent;
            }
        }
    }

    HorizontalLayout {
        padding: 0px;
        Text {
            text: used-text;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: left;
        }
        Text {
            text: "of " + cap-text;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: right;
        }
    }
}

// ---------------------------------------------------------------------------
// DiskFileCard: row representation of a file in the disk pane
// ---------------------------------------------------------------------------

component DiskFileCard inherits Rectangle {
    in property <FileMeta> meta;

    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-disk(string);

    property <bool> is-dragged: DragState.active && DragState.file-id == meta.id && DragState.source-tier == "disk";

    background: is-dragged ? Theme.card-bg-dragged : (card-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
    border-color: is-dragged ? #eb6834 : (card-touch.has-hover ? Theme.border-medium : Theme.border-light);
    border-width: 1px;
    border-radius: 8px;
    height: 36px;
    opacity: is-dragged ? 0.35 : 1.0;

    property <length> press-start-x: 0px;
    property <length> press-start-y: 0px;
    property <bool> tracking-press: false;
    property <length> cur-x: 0px;
    property <length> cur-y: 0px;
    property <length> dx: 0px;
    property <length> dy: 0px;

    card-touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-start-x = self.absolute-position.x + self.mouse-x;
                root.press-start-y = self.absolute-position.y + self.mouse-y;
                root.tracking-press = true;
            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (root.tracking-press) {
                    root.tracking-press = false;
                    if (DragState.active && DragState.file-id == meta.id) {
                        if (DragState.hover-valid) {
                            if (DragState.hover-target == "db") {
                                root.save-to-db(meta.id);
                            } else if (DragState.hover-target == "cloud") {
                                root.save-to-cloud(meta.id);
                            }
                        }
                        DragState.active = false;
                        DragState.hover-target = "none";
                        DragState.hover-valid = false;
                        DragState.hover-reason = "";
                    }
                }
            }
        }
        moved => {
            if (self.pressed && root.tracking-press) {
                root.cur-x = self.absolute-position.x + self.mouse-x;
                root.cur-y = self.absolute-position.y + self.mouse-y;
                root.dx = root.cur-x > root.press-start-x ? root.cur-x - root.press-start-x : root.press-start-x - root.cur-x;
                root.dy = root.cur-y > root.press-start-y ? root.cur-y - root.press-start-y : root.press-start-y - root.cur-y;

                if (!DragState.active) {
                    if (root.dx > 4px || root.dy > 4px) {
                        DragState.file-id = meta.id;
                        DragState.file-name = meta.name;
                        DragState.file-size = meta.size;
                        DragState.file-size-formatted = meta.size-formatted;
                        DragState.file-color = meta.color;
                        DragState.source-tier = "disk";
                        DragState.pointer-x = root.cur-x;
                        DragState.pointer-y = root.cur-y;
                        DragState.active = true;
                    }
                } else {
                    if (DragState.file-id == meta.id) {
                        DragState.pointer-x = root.cur-x;
                        DragState.pointer-y = root.cur-y;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Drag handle indicator
        Text {
            text: "⋮⋮";
            color: Theme.handle-color;
            font-size: 13px;
            vertical-alignment: center;
        }

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: meta.color;
        }

        // File name
        Text {
            text: meta.name;
            color: Theme.text-primary;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Formatted size
        Text {
            text: meta.size-formatted;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }

        // Action buttons
        ActionButton {
            text: "to db";
            clicked => { root.save-to-db(meta.id); }
        }
        ActionButton {
            text: "to cloud";
            clicked => { root.save-to-cloud(meta.id); }
        }
        ActionButton {
            text: "✕";
            danger: true;
            clicked => { root.delete-from-disk(meta.id); }
        }
    }
}

// ---------------------------------------------------------------------------
// FileCard: row representation of a file in a store pane
// ---------------------------------------------------------------------------

component FileCard inherits Rectangle {
    in property <FileMeta> meta;

    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);

    property <bool> is-dragged: DragState.active && DragState.file-id == meta.id && DragState.source-tier == "ram";

    background: is-dragged ? Theme.card-bg-dragged : (card-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
    border-color: is-dragged ? Theme.primary : (card-touch.has-hover ? Theme.border-medium : Theme.border-light);
    border-width: 1px;
    border-radius: 8px;
    height: 36px;
    opacity: is-dragged ? 0.35 : 1.0;

    property <length> press-start-x: 0px;
    property <length> press-start-y: 0px;
    property <bool> tracking-press: false;
    property <length> cur-x: 0px;
    property <length> cur-y: 0px;
    property <length> dx: 0px;
    property <length> dy: 0px;

    card-touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-start-x = self.absolute-position.x + self.mouse-x;
                root.press-start-y = self.absolute-position.y + self.mouse-y;
                root.tracking-press = true;
            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (root.tracking-press) {
                    root.tracking-press = false;
                    if (DragState.active && DragState.file-id == meta.id) {
                        if (DragState.hover-valid) {
                            if (DragState.hover-target == "disk") {
                                root.persist-to-disk(meta.id);
                            } else if (DragState.hover-target == "db") {
                                root.save-to-db(meta.id);
                            } else if (DragState.hover-target == "cloud") {
                                root.save-to-cloud(meta.id);
                            }
                        }
                        DragState.active = false;
                        DragState.hover-target = "none";
                        DragState.hover-valid = false;
                        DragState.hover-reason = "";
                    }
                }
            }
        }
        moved => {
            if (self.pressed && root.tracking-press) {
                root.cur-x = self.absolute-position.x + self.mouse-x;
                root.cur-y = self.absolute-position.y + self.mouse-y;
                root.dx = root.cur-x > root.press-start-x ? root.cur-x - root.press-start-x : root.press-start-x - root.cur-x;
                root.dy = root.cur-y > root.press-start-y ? root.cur-y - root.press-start-y : root.press-start-y - root.cur-y;

                if (!DragState.active) {
                    if (root.dx > 4px || root.dy > 4px) {
                        DragState.file-id = meta.id;
                        DragState.file-name = meta.name;
                        DragState.file-size = meta.size;
                        DragState.file-size-formatted = meta.size-formatted;
                        DragState.file-color = meta.color;
                        DragState.source-tier = "ram";
                        DragState.pointer-x = root.cur-x;
                        DragState.pointer-y = root.cur-y;
                        DragState.active = true;
                    }
                } else {
                    if (DragState.file-id == meta.id) {
                        DragState.pointer-x = root.cur-x;
                        DragState.pointer-y = root.cur-y;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Drag handle indicator
        Text {
            text: "⋮⋮";
            color: Theme.handle-color;
            font-size: 13px;
            vertical-alignment: center;
        }

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: meta.color;
        }

        // File name
        Text {
            text: meta.name;
            color: Theme.text-primary;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Formatted size
        Text {
            text: meta.size-formatted;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }

        // Action buttons
        ActionButton {
            text: "to disk";
            clicked => { root.persist-to-disk(meta.id); }
        }
        ActionButton {
            text: "to db";
            clicked => { root.save-to-db(meta.id); }
        }
        ActionButton {
            text: "to cloud";
            clicked => { root.save-to-cloud(meta.id); }
        }
        ActionButton {
            text: "✕";
            danger: true;
            clicked => { root.delete-from-ram(meta.id); }
        }
    }
}

// ---------------------------------------------------------------------------
// RamPane: full RAM tier pane
// ---------------------------------------------------------------------------

component RamPane inherits Rectangle {
    in property <string> used-text: "0 B";
    in property <string> cap-text: "10.0 MB";
    in property <int> used-bytes: 0;
    in property <int> cap-bytes: 10485760;
    in property <[FileMeta]> files;

    callback browse-ram();
    callback stream-to-disk();
    callback pull-the-plug();
    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);

    property <bool> is-drop-target: DragState.active && DragState.hover-target == "ram";
    property <bool> drop-valid: DragState.hover-valid;
    property <string> drop-reason: DragState.hover-reason;

    background: is-drop-target ? Theme.danger-bg : Theme.card-bg;
    border-color: is-drop-target ? Theme.danger : Theme.border-card;
    border-width: is-drop-target ? 2px : 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "RAM";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "volatile — cleared when app closes";
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Meter {
            used: used-bytes;
            cap: cap-bytes;
            used-text: used-text;
            cap-text: cap-text;
            segments: files;
        }

        // Click-to-browse only: unlike the Tauri build (which received real OS
        // file-manager drops via a native Tauri event), Slint 1.17's DropArea/
        // DataTransfer API carries only images, plain text, and same-process
        // payloads — no file paths — so external OS drag-and-drop of files
        // from outside this window cannot be wired up on this Slint version.
        // In-app dragging a file between panes (is-drop-target/DragState
        // below) is unaffected; that path never needed OS file data.
        Rectangle {
            height: 70px;
            background: is-drop-target ? Theme.danger-bg-hover : (drop-touch.has-hover ? Theme.dropzone-bg-hover : Theme.dropzone-bg);
            border-width: 2px;
            border-color: is-drop-target ? Theme.danger : (drop-touch.has-hover ? Theme.primary : Theme.border-medium);
            border-radius: 10px;

            drop-touch := TouchArea {
                clicked => { root.browse-ram(); }
            }

            Text {
                text: is-drop-target ? drop-reason : (files.length == 0 ? "click to browse for files" : files.length + " file(s) in RAM");
                color: is-drop-target ? Theme.danger : Theme.text-faint;
                font-size: 13px;
                font-weight: is-drop-target ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Flickable {
            min-height: 100px;
            vertical-stretch: 1;
            viewport-height: files-layout.preferred-height;

            files-layout := VerticalLayout {
                spacing: 6px;
                for f in files: FileCard {
                    meta: f;
                    persist-to-disk(id) => { root.persist-to-disk(id); }
                    save-to-db(id) => { root.save-to-db(id); }
                    save-to-cloud(id) => { root.save-to-cloud(id); }
                    delete-from-ram(id) => { root.delete-from-ram(id); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            PaneButton {
                text: "Upload";
                primary: true;
                clicked => { root.browse-ram(); }
            }
            PaneButton {
                text: "Stream to disk";
                clicked => { root.stream-to-disk(); }
            }
            PaneButton {
                text: "Pull the plug";
                danger: true;
                clicked => { root.pull-the-plug(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// DiskPane: full disk tier pane
// ---------------------------------------------------------------------------

component DiskPane inherits Rectangle {
    in property <string> used-text: "0 B";
    in property <string> cap-text: "20.0 MB";
    in property <int> used-bytes: 0;
    in property <int> cap-bytes: 20971520;
    in property <[FileMeta]> segments;
    in property <[DiskFile]> files;
    in property <string> vault-path: "";

    callback reveal-vault();
    callback rescan-vault();
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-disk(string);

    property <bool> is-drop-target: DragState.active && DragState.hover-target == "disk";
    property <bool> drop-valid: DragState.hover-valid;
    property <string> drop-reason: DragState.hover-reason;
    property <int> preview-add-bytes: DragState.active && is-drop-target && drop-valid ? DragState.file-size : 0;

    background: is-drop-target ? (drop-valid ? Theme.success-bg : Theme.danger-bg) : Theme.card-bg;
    border-color: is-drop-target ? (drop-valid ? Theme.success : Theme.danger) : (DragState.active && DragState.source-tier == "ram" ? Theme.primary : Theme.border-card);
    border-width: (is-drop-target || (DragState.active && DragState.source-tier == "ram")) ? 2px : 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "DISK";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "persistent — survives a restart";
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Meter {
            used: used-bytes;
            cap: cap-bytes;
            used-text: used-text;
            cap-text: cap-text;
            segments: segments;
            preview-add-bytes: preview-add-bytes;
            preview-add-color: DragState.file-color;
        }

        Rectangle {
            height: 70px;
            background: is-drop-target ? (drop-valid ? Theme.success-bg-hover : Theme.danger-bg-hover) : Theme.dropzone-bg;
            border-width: 2px;
            border-color: is-drop-target ? (drop-valid ? Theme.success : Theme.danger) : Theme.border-medium;
            border-radius: 10px;

            Text {
                text: is-drop-target ? drop-reason : (files.length == 0 ? "drag from RAM to keep" : files.length + " file(s) on disk");
                color: is-drop-target ? (drop-valid ? Theme.success : Theme.danger) : Theme.text-faint;
                font-size: 13px;
                font-weight: is-drop-target ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Flickable {
            min-height: 100px;
            vertical-stretch: 1;
            viewport-height: files-layout.preferred-height;

            files-layout := VerticalLayout {
                spacing: 6px;
                for f in files: DiskFileCard {
                    meta: f.meta;
                    save-to-db(id) => { root.save-to-db(id); }
                    save-to-cloud(id) => { root.save-to-cloud(id); }
                    delete-from-disk(id) => { root.delete-from-disk(id); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            PaneButton {
                text: "Open folder";
                clicked => { root.reveal-vault(); }
            }
            PaneButton {
                text: "Rescan";
                clicked => { root.rescan-vault(); }
            }
            Text {
                text: root.vault-path;
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// SinkFileCard: row representation of a file in a sink (DB/Cloud) panel.
// Named distinctly from the RAM pane's FileCard (different signature: a
// single delete-clicked callback rather than the four RAM tier actions).
// ---------------------------------------------------------------------------

component SinkFileCard inherits Rectangle {
    in property <FileMeta> meta;
    in property <string> delete-title: "Delete file";
    callback delete-clicked();

    background: Theme.card-bg;
    border-color: Theme.border-light;
    border-width: 1px;
    border-radius: 8px;
    height: 36px;

    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: Theme.sink-indicator;
        }

        // File name
        Text {
            text: meta.name;
            color: Theme.sink-text;
            font-size: 12px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        // Size
        Text {
            text: meta.size-formatted;
            color: Theme.text-faint;
            font-size: 11px;
            vertical-alignment: center;
        }

        // Delete button ✕
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.border-light;
            background: touch.has-hover ? Theme.border-light : transparent;

            Text {
                text: "✕";
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => { root.delete-clicked(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Database and Cloud compact sink panels. Ported from SinkPanel.tsx.
// ---------------------------------------------------------------------------

component SinkPanel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> panel-tier; // "db" | "cloud"
    in property <bool> connected;
    in property <int> used-bytes;
    in property <int> cap-bytes: 104857600;
    in property <string> used-text;
    in property <string> cap-text;
    in property <string> detail-text;
    in property <string> offline-message;
    in property <string> delete-title: "Delete file";
    in property <[FileMeta]> files;

    callback delete-file(string);

    property <bool> is-drop-target: DragState.active && DragState.hover-target == panel-tier;
    property <bool> drop-valid: DragState.hover-valid;
    property <string> drop-reason: DragState.hover-reason;
    property <int> preview-add-bytes: DragState.active && is-drop-target && drop-valid ? DragState.file-size : 0;

    background: is-drop-target ? (drop-valid ? Theme.success-bg : Theme.danger-bg) : Theme.card-bg;
    border-color: is-drop-target ? (drop-valid ? Theme.success : Theme.danger) : Theme.border-card;
    border-width: is-drop-target ? 2px : 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        // Header: Title and Subtitle
        HorizontalBox {
            spacing: 8px;
            padding: 0px;
            Text {
                text: title;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
            }
            Text {
                text: subtitle;
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            if is-drop-target: Text {
                text: drop-reason;
                color: drop-valid ? Theme.success : Theme.danger;
                font-size: 11px;
                font-weight: 600;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // Offline state
        if !connected : Rectangle {
            background: Theme.border-light;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;

                Text {
                    text: offline-message != "" ? offline-message : "offline";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Online state
        if connected : VerticalBox {
            padding: 0px;
            spacing: 8px;

            // Segmented Meter Track (100 MB cap visualization)
            Rectangle {
                height: 22px;
                background: Theme.border-light;
                border-radius: 6px;
                clip: true;

                HorizontalLayout {
                    padding: 0px;
                    spacing: 2px;

                    if used-bytes > 0: Rectangle {
                        horizontal-stretch: max(1, used-bytes);
                        background: Theme.sink-indicator;
                    }

                    if preview-add-bytes > 0: Rectangle {
                        horizontal-stretch: max(1, preview-add-bytes);
                        background: DragState.file-color.transparentize(0.4);
                        border-width: 1px;
                        border-color: DragState.file-color;
                        border-radius: 2px;
                    }

                    if cap-bytes > (used-bytes + preview-add-bytes): Rectangle {
                        horizontal-stretch: max(0, cap-bytes - (used-bytes + preview-add-bytes));
                        background: transparent;
                    }
                }
            }

            // Meter Caption
            HorizontalBox {
                padding: 0px;
                Text {
                    text: used-text;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: left;
                }
                Text {
                    text: "of " + cap-text;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }

            // Physical Note / Extra Detail
            if detail-text != "" : Text {
                text: detail-text;
                color: Theme.text-faint;
                font-size: 11px;
            }

            // File List
            if files.length == 0 : Text {
                text: "No files stored in this tier yet";
                color: Theme.text-faint;
                font-size: 11px;
            }

            if files.length > 0 : ScrollView {
                max-height: 220px;
                VerticalLayout {
                    spacing: 6px;
                    for f in files : SinkFileCard {
                        meta: f;
                        delete-title: root.delete-title;
                        delete-clicked => { root.delete-file(f.id); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Sparkline: bar-style time series. One thin Rectangle per history point, each
// bar's height bound to `parent.height * (value / max-value)`. This is the Slint
// replacement for the React SVG line sparkline — Slint's `Path` cannot hold a
// `for` loop, so a real bar sparkline out of layout Rectangles it is. The `rss`
// field is shown when `show-rss` is set, otherwise `ram`.
// ---------------------------------------------------------------------------

component Sparkline inherits Rectangle {
    in property <[HistoryPoint]> points;
    in property <int> max-value: 1;
    in property <bool> show-rss: false;
    in property <color> bar-color: Theme.primary;

    height: 64px;
    background: Theme.card-bg;
    border-color: Theme.border-light;
    border-width: 1px;
    border-radius: 6px;
    clip: true;

    HorizontalLayout {
        padding: 4px;
        spacing: 1px;

        for point in points: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Bar height as a fraction of the track; a transparent spacer sits
            // above it so bars grow up from the baseline like a real sparkline.
            property <length> bar-height: parent.height * ((show-rss ? point.rss : point.ram) * 1.0 / max-value);

            Rectangle {
                height: max(0px, parent.height - bar-height);
            }

            Rectangle {
                height: bar-height;
                background: bar-color;
                border-radius: 1px;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Instruments: the collapsible dashboard drawer. Two stacked time-series charts
// — RAM store bytes and process RSS — each with its own y-scale, sharing the
// same x-axis (the 4 Hz history buffer). Deliberately two charts, never one
// plot with two y-axes (the hard rule from CLAUDE.md). Plus the file table.
// ---------------------------------------------------------------------------

component Instruments inherits VerticalBox {
    in property <[HistoryPoint]> history;
    in property <int> ram-max: 10485760;
    in property <int> rss-max: 1;
    in property <string> ram-series-label: "RAM store bytes (0–10 MB)";
    in property <string> rss-series-label: "Process RSS (whole tree, auto-scaled)";
    in property <string> axis-note: "Two separate scales, deliberately never combined on one axis — see docs/03-ui-and-visualization.md.";
    in property <[FileTableRow]> table-rows;

    property <bool> open: false;

    spacing: 4px;

    Rectangle {
        height: 32px;
        border-radius: 6px;
        background: touch.has-hover ? Theme.border-light : transparent;

        touch := TouchArea {
            clicked => { open = !open; }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;

            Text {
                text: open ? "▾ Instruments — time series · file table" : "▸ Instruments — time series · file table";
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    if open : VerticalBox {
        spacing: 6px;

        Text {
            text: ram-series-label;
            color: Theme.text-muted;
            font-size: 11px;
        }
        Sparkline {
            points: history;
            max-value: ram-max;
            bar-color: Theme.sparkline-ram;
        }

        Text {
            text: rss-series-label;
            color: Theme.text-muted;
            font-size: 11px;
        }
        Sparkline {
            points: history;
            max-value: rss-max;
            show-rss: true;
            bar-color: Theme.sparkline-rss;
        }

        Text {
            text: axis-note;
            color: Theme.note-text;
            font-size: 11px;
        }

        Rectangle {
            background: Theme.card-bg;
            border-color: Theme.border-light;
            border-width: 1px;
            border-radius: 6px;
            height: 200px;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                HorizontalLayout {
                    Text { text: "Name"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; horizontal-stretch: 3; overflow: elide; }
                    Text { text: "Size"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "Tier"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "Mime"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; horizontal-stretch: 2; overflow: elide; }
                }

                if table-rows.length == 0 : Text {
                    text: "no files in any tier yet";
                    color: Theme.text-faint;
                    font-size: 11px;
                }

                if table-rows.length > 0 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 2px;

                        for row in table-rows: HorizontalLayout {
                            Text { text: row.name; color: Theme.text-primary; font-size: 12px; horizontal-stretch: 3; vertical-alignment: center; overflow: elide; }
                            Text { text: row.size-formatted; color: Theme.text-muted; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: row.tier; color: Theme.text-muted; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: row.mime; color: Theme.text-muted; font-size: 12px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// StreamModal: overlay modal for streaming upload report
// ---------------------------------------------------------------------------

component StreamModal inherits Rectangle {
    in property <StreamReport> report;
    callback close();

    background: #00000066;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: 580px;
        background: Theme.card-bg;
        border-color: Theme.border-card;
        border-width: 1px;
        border-radius: 12px;

        TouchArea {}

        VerticalBox {
            padding: 20px;
            spacing: 14px;

            Text {
                text: "Streaming report — " + report.file-name;
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: report.bytes-total-formatted + " moved in " + report.elapsed-ms-formatted + " (" + report.throughput-mb-s + "), reading/writing in fixed " + report.chunk-size-formatted + " chunks — peak memory for this operation never exceeds one chunk, regardless of file size.";
                color: Theme.text-muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;

                StatTile {
                    horizontal-stretch: 1;
                    tile-label: "Streaming peak (measured)";
                    tile-value: report.chunk-size-formatted;
                    tile-caption: "fixed chunk size";
                }
                StatTile {
                    horizontal-stretch: 1;
                    tile-label: "Buffered would need (derived)";
                    tile-value: report.buffered-equivalent-peak-bytes-formatted;
                    tile-caption: "entire file in RAM";
                }
                StatTile {
                    horizontal-stretch: 1;
                    tile-label: "Files at once — streaming";
                    tile-value: "" + report.max-concurrent-streaming;
                    tile-caption: "against 10 MB RAM cap";
                }
                StatTile {
                    horizontal-stretch: 1;
                    tile-label: "Files at once — buffered";
                    tile-value: "" + report.max-concurrent-buffered;
                    tile-caption: "against 10 MB RAM cap";
                }
            }

            Text {
                text: "RSS during transfer — baseline " + report.rss-baseline-formatted + ", peak " + report.rss-peak-formatted + ", average " + report.rss-avg-formatted + " (delta " + report.rss-peak-delta-formatted + "). Concurrency figures are calculated against the 10 MB RAM cap, not live-measured.";
                color: Theme.text-faint;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding: 0px;
                alignment: end;

                PaneButton {
                    text: "Close";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The shell.
// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Ephemera — RAM vs Disk vs Database vs Cloud";
    width: 1280px;
    height: 860px;
    background: Theme.window-bg;

    // ---- State model: mirrors src/store/useAppStore.ts -------------------
    in-out property <string> vault-path: "";
    in-out property <[FileMeta]> ram-files;
    in-out property <[DiskFile]> disk-files;
    in-out property <[DbFile]> db-files;
    in-out property <[CloudFile]> cloud-files;
    in-out property <Metrics> metrics: {
        ts: "",
        ram-store-bytes: 0,
        ram-cap: 10485760,
        disk-store-bytes: 0,
        disk-cap: 20971520,
        db-store-bytes: 0,
        db-cap: 104857600,
        db-physical-bytes: 0,
        cloud-store-bytes: 0,
        cloud-cap: 104857600,
        process-rss-bytes: 0,
        process-count: 1,
    };
    in-out property <DbStatus> db-status: {
        connected: false,
        logical-bytes: 0,
        physical-bytes: 0,
        cap: 104857600,
        message: "",
    };
    in-out property <CloudStatus> cloud-status: {
        connected: false,
        bytes-used: 0,
        cap: 104857600,
        bucket: "",
        message: "",
    };

    in-out property <[FileMeta]> db-meta-files;
    in-out property <[FileMeta]> cloud-meta-files;
    // FileMeta display projection of the disk list (the disk pane's meter binds
    // segments against these; the full DiskFile model above stays the state).
    in-out property <[FileMeta]> disk-meta-files;

    in-out property <string> ram-used-text: "0 B";
    in-out property <string> ram-cap-text: "10.0 MB";
    in-out property <string> ram-count-text: "0 files in RAM";
    in-out property <string> disk-used-text: "0 B";
    in-out property <string> disk-cap-text: "20.0 MB";
    in-out property <string> disk-count-text: "0 files on disk";
    in-out property <string> app-memory-text: "0 B";
    in-out property <string> app-memory-caption: "process tree, approximated";
    in-out property <string> files-text: "0 / 0";
    in-out property <string> files-caption: "ram / disk";
    in-out property <string> db-used-text: "0 B";
    in-out property <string> db-cap-text: "100.0 MB";
    in-out property <string> db-count-text: "0 files in database";
    in-out property <string> db-detail-text: "database: not connected";
    in-out property <string> cloud-used-text: "0 B";
    in-out property <string> cloud-cap-text: "100.0 MB";
    in-out property <string> cloud-count-text: "0 files in cloud";
    in-out property <string> cloud-detail-text: "cloud: not connected";
    in-out property <int> history-len: 0;
    // Projection of the Rust-side 240-point ring buffer (see model.rs
    // `MetricPoint` / `ShellState.history`) into the two stacked sparklines.
    in-out property <[HistoryPoint]> history;
    in-out property <int> rss-max: 1;
    in-out property <string> rss-series-label: "Process RSS (whole tree, auto-scaled)";
    in-out property <[FileTableRow]> file-table-rows;
    in-out property <string> error-message: "";
    in-out property <bool> show-stream-report: false;
    in-out property <StreamReport> stream-report;

    callback close-stream-report();

    // Slint → Rust: delete actions from sink panels
    callback delete-db-file(string);
    callback delete-cloud-file(string);

    // Slint → Rust: the placeholder "refresh everything" action. Rust handles it
    // with direct ephemera-core calls — the old `refreshAll` zustand action had
    // to cross IPC, this one does not.
    callback refresh-all();
    callback upload-ram-files();
    callback stream-upload-to-disk();
    callback flush-ram();
    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);
    callback reveal-vault();
    callback rescan-vault();
    callback save-disk-to-db(string);
    callback save-disk-to-cloud(string);
    callback delete-from-disk(string);
    callback clear-error();
    callback toggle-dark-mode();

    // Drag target tracking logic
    property <bool> pointer-in-ram: DragState.active &&
        DragState.pointer-x >= ram-pane.absolute-position.x &&
        DragState.pointer-x <= ram-pane.absolute-position.x + ram-pane.width &&
        DragState.pointer-y >= ram-pane.absolute-position.y &&
        DragState.pointer-y <= ram-pane.absolute-position.y + ram-pane.height;

    property <bool> pointer-in-disk: DragState.active &&
        DragState.pointer-x >= disk-pane.absolute-position.x &&
        DragState.pointer-x <= disk-pane.absolute-position.x + disk-pane.width &&
        DragState.pointer-y >= disk-pane.absolute-position.y &&
        DragState.pointer-y <= disk-pane.absolute-position.y + disk-pane.height;

    property <bool> pointer-in-db: DragState.active &&
        DragState.pointer-x >= db-panel.absolute-position.x &&
        DragState.pointer-x <= db-panel.absolute-position.x + db-panel.width &&
        DragState.pointer-y >= db-panel.absolute-position.y &&
        DragState.pointer-y <= db-panel.absolute-position.y + db-panel.height;

    property <bool> pointer-in-cloud: DragState.active &&
        DragState.pointer-x >= cloud-panel.absolute-position.x &&
        DragState.pointer-x <= cloud-panel.absolute-position.x + cloud-panel.width &&
        DragState.pointer-y >= cloud-panel.absolute-position.y &&
        DragState.pointer-y <= cloud-panel.absolute-position.y + cloud-panel.height;

    property <string> current-hover-target: pointer-in-ram ? "ram" : (
        pointer-in-disk ? "disk" : (
            pointer-in-db ? "db" : (
                pointer-in-cloud ? "cloud" : "none"
            )
        )
    );

    property <bool> current-hover-valid:
        current-hover-target == "disk" ? (
            DragState.source-tier == "ram" && (root.metrics.disk-store-bytes + DragState.file-size <= root.metrics.disk-cap)
        ) : (
            current-hover-target == "db" ? (
                root.db-status.connected && (root.db-status.logical-bytes + DragState.file-size <= root.db-status.cap)
            ) : (
                current-hover-target == "cloud" ? (
                    root.cloud-status.connected && (root.cloud-status.bytes-used + DragState.file-size <= root.cloud-status.cap)
                ) : false
            )
        );

    property <string> current-hover-reason:
        current-hover-target == "ram" ? (
            DragState.source-tier == "disk" ? "One-way rule: cannot move files back to RAM" : "Already in RAM"
        ) : (
            current-hover-target == "disk" ? (
                DragState.source-tier == "disk" ? "Already on Disk" : (
                    root.metrics.disk-store-bytes + DragState.file-size > root.metrics.disk-cap ?
                        "Disk quota exceeded — file cannot fit" : "Drop to persist to Disk"
                )
            ) : (
                current-hover-target == "db" ? (
                    !root.db-status.connected ? "Database offline" : (
                        root.db-status.logical-bytes + DragState.file-size > root.db-status.cap ?
                            "Database quota exceeded — file cannot fit" : "Drop to save to Database"
                    )
                ) : (
                    current-hover-target == "cloud" ? (
                        !root.cloud-status.connected ? "Cloud storage offline" : (
                            root.cloud-status.bytes-used + DragState.file-size > root.cloud-status.cap ?
                                "Cloud quota exceeded — file cannot fit" : "Drop to save to Cloud"
                        )
                    ) : ""
                )
            )
        );

    changed current-hover-target => {
        DragState.hover-target = root.current-hover-target;
        DragState.hover-valid = root.current-hover-valid;
        DragState.hover-reason = root.current-hover-reason;
    }
    changed current-hover-valid => {
        DragState.hover-valid = root.current-hover-valid;
    }
    changed current-hover-reason => {
        DragState.hover-reason = root.current-hover-reason;
    }

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        if root.error-message != "": Rectangle {
            background: Theme.danger-bg;
            border-width: 1px;
            border-color: Theme.danger;
            border-radius: 8px;
            height: 38px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: root.error-message;
                    color: Theme.danger;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                ActionButton {
                    text: "✕";
                    danger: true;
                    clicked => { root.clear-error(); }
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            Text {
                text: "Ephemera";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: "vault: " + root.vault-path;
                color: Theme.text-muted;
                font-size: 14px;
                vertical-alignment: center;
            }
            PaneButton {
                text: Theme.dark-mode ? "☀️ Light" : "🌙 Dark";
                clicked => { root.toggle-dark-mode(); }
            }
            PaneButton {
                text: "Refresh";
                clicked => { root.refresh-all(); }
            }
        }

        HorizontalBox {
            StatTile {
                tile-label: "RAM USED";
                tile-value: root.ram-used-text;
                tile-caption: "of " + root.ram-cap-text;
            }
            StatTile {
                tile-label: "DISK USED";
                tile-value: root.disk-used-text;
                tile-caption: "of " + root.disk-cap-text;
            }
            StatTile {
                tile-label: "APP MEMORY";
                tile-value: root.app-memory-text;
                tile-caption: root.app-memory-caption;
            }
            StatTile {
                tile-label: "FILES";
                tile-value: root.files-text;
                tile-caption: root.files-caption;
            }
        }

        HorizontalBox {
            ram-pane := RamPane {
                used-text: root.ram-used-text;
                cap-text: root.ram-cap-text;
                used-bytes: root.metrics.ram-store-bytes;
                cap-bytes: root.metrics.ram-cap;
                files: root.ram-files;

                browse-ram => { root.upload-ram-files(); }
                stream-to-disk => { root.stream-upload-to-disk(); }
                pull-the-plug => { root.flush-ram(); }
                persist-to-disk(id) => { root.persist-to-disk(id); }
                save-to-db(id) => { root.save-to-db(id); }
                save-to-cloud(id) => { root.save-to-cloud(id); }
                delete-from-ram(id) => { root.delete-from-ram(id); }
            }
            disk-pane := DiskPane {
                used-text: root.disk-used-text;
                cap-text: root.disk-cap-text;
                used-bytes: root.metrics.disk-store-bytes;
                cap-bytes: root.metrics.disk-cap;
                segments: root.disk-meta-files;
                files: root.disk-files;
                vault-path: root.vault-path;

                reveal-vault => { root.reveal-vault(); }
                rescan-vault => { root.rescan-vault(); }
                save-to-db(id) => { root.save-disk-to-db(id); }
                save-to-cloud(id) => { root.save-disk-to-cloud(id); }
                delete-from-disk(id) => { root.delete-from-disk(id); }
            }
        }

        HorizontalBox {
            db-panel := SinkPanel {
                title: "DATABASE";
                subtitle: "postgres (docker)";
                panel-tier: "db";
                connected: root.db-status.connected;
                used-bytes: root.db-status.logical-bytes;
                cap-bytes: root.db-status.cap;
                used-text: root.db-used-text;
                cap-text: root.db-cap-text;
                detail-text: root.db-detail-text;
                offline-message: root.db-status.message != "" ? root.db-status.message : "Database offline — start it with docker compose up -d";
                delete-title: "Delete from database";
                files: root.db-meta-files;
                delete-file(id) => { root.delete-db-file(id); }
            }
            cloud-panel := SinkPanel {
                title: "CLOUD";
                subtitle: "gcs bucket";
                panel-tier: "cloud";
                connected: root.cloud-status.connected;
                used-bytes: root.cloud-status.bytes-used;
                cap-bytes: root.cloud-status.cap;
                used-text: root.cloud-used-text;
                cap-text: root.cloud-cap-text;
                detail-text: root.cloud-detail-text;
                offline-message: root.cloud-status.message != "" ? root.cloud-status.message : "GCS bucket offline or gcs-key.json missing";
                delete-title: "Delete from cloud";
                files: root.cloud-meta-files;
                delete-file(id) => { root.delete-cloud-file(id); }
            }
        }

        Instruments {
            history: root.history;
            ram-max: root.metrics.ram-cap;
            rss-max: root.rss-max;
            rss-series-label: root.rss-series-label;
            table-rows: root.file-table-rows;
        }
    }

    // Floating Drag Avatar overlay
    if DragState.active: Rectangle {
        x: DragState.pointer-x - 110px;
        y: DragState.pointer-y - 20px;
        width: 220px;
        height: 40px;

        background: Theme.card-bg;
        border-radius: 8px;
        border-width: 2px;
        border-color: DragState.hover-target == "none" ? Theme.primary : (
            DragState.hover-valid ? Theme.success : Theme.danger
        );

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 8px;

            Text {
                text: "⋮⋮";
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 3px;
                background: DragState.file-color;
            }

            Text {
                text: DragState.file-name;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Text {
                text: DragState.file-size-formatted;
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }

            Rectangle {
                border-radius: 4px;
                background: DragState.hover-target == "none" ? Theme.border-light : (
                    DragState.hover-valid ? Theme.success : Theme.danger
                );

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: DragState.hover-target == "none" ? "Dragging" : (
                            DragState.hover-valid ? "Drop target" : "Invalid"
                        );
                        color: DragState.hover-target == "none" ? Theme.text-secondary : #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.show-stream-report : StreamModal {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        report: root.stream-report;
        close => { root.close-stream-report(); }
    }
}
