// Ephemera — Slint application shell (Phase 2 & Phase 3: RAM Pane, Disk Pane).
//
// This window replaces the Tauri + React shell. The Rust side (`src/model.rs`)
// owns the state model and pushes these properties directly; there is no IPC and
// no serialization boundary — UI and core run in one process, one address space.
//
// The metadata-only discipline from CLAUDE.md survives the removal of that
// boundary by being enforced here in code: every property in this file carries
// metadata (names, sizes, mime types, origins, timestamps, statuses, tiers) and
// NEVER file byte content. The authoritative byte stores live exclusively inside
// `ephemera_core::state::AppState` (RAM heap buffer, vault folder, Postgres, GCS).

import { Button, HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// State model structs.
// ---------------------------------------------------------------------------

export struct FileMeta {
    id: string,
    name: string,
    size: int,               // bytes — metadata, never the bytes themselves
    mime: string,
    created-at: string,      // formatted from FileMeta.created_at
    origin: string,          // "upload" | "stream" | "ram" | "disk"
    color: color,
    size-formatted: string,
}

export struct DiskFile {
    meta: FileMeta,
    persisted-at: string,    // formatted from DiskFile.persisted_at
}

export struct DbFile {
    meta: FileMeta,
    saved-at: string,        // formatted from DbFile.saved_at
}

export struct CloudFile {
    meta: FileMeta,
    saved-at: string,        // formatted from CloudFile.saved_at
    object-name: string,
}

export struct Metrics {
    ts: string,              // formatted from Metrics.ts
    ram-store-bytes: int,
    ram-cap: int,
    disk-store-bytes: int,
    disk-cap: int,
    db-store-bytes: int,
    db-cap: int,
    db-physical-bytes: int,
    cloud-store-bytes: int,
    cloud-cap: int,
    process-rss-bytes: int,
    process-count: int,
}

export struct DbStatus {
    connected: bool,
    logical-bytes: int,
    physical-bytes: int,
    cap: int,
    message: string,
}

export struct CloudStatus {
    connected: bool,
    bytes-used: int,
    cap: int,
    bucket: string,
    message: string,
}

export struct HistoryPoint {
    ram: int,               // ram_store_bytes at this tick
    rss: int,               // process_rss_bytes at this tick
}

export struct FileTableRow {
    name: string,
    size-formatted: string,
    tier: string,           // "RAM" | "Disk" | "Database" | "Cloud"
    mime: string,
}

// ---------------------------------------------------------------------------
// KPI row stat tile.
// ---------------------------------------------------------------------------

component StatTile inherits Rectangle {
    in property <string> tile-label;
    in property <string> tile-value;
    in property <string> tile-caption;

    background: #fffdf8;
    border-color: #c9c1b4;
    border-width: 1px;
    border-radius: 6px;

    VerticalBox {
        padding: 12px;
        spacing: 2px;
        Text {
            text: tile-label;
            color: #68747b;
            font-size: 12px;
        }
        Text {
            text: tile-value;
            color: #24303a;
            font-size: 22px;
            font-weight: 700;
        }
        Text {
            text: tile-caption;
            color: #68747b;
            font-size: 12px;
        }
    }
}

// ---------------------------------------------------------------------------
// ActionButton: compact button for FileCard items
// ---------------------------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    height: 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.has-hover ? #c3c2b7 : #e1e0d9;
    background: touch.has-hover ? #e1e0d9 : #fffdf8;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: danger ? #d03b3b : #52514e;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// PaneButton: button for pane actions
// ---------------------------------------------------------------------------

component PaneButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: primary ? #2a78d6 : (touch.has-hover ? #c3c2b7 : #e1e0d9);
    background: primary ? (touch.has-hover ? #1f64b8 : #2a78d6) : (touch.has-hover ? #e1e0d9 : #fffdf8);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: primary ? #ffffff : (danger ? #d03b3b : #24303a);
            font-size: 12px;
            font-weight: primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Meter: segmented store meter
// ---------------------------------------------------------------------------

component Meter inherits VerticalBox {
    in property <int> used: 0;
    in property <int> cap: 10485760;
    in property <string> used-text: "0 B";
    in property <string> cap-text: "10.0 MB";
    in property <[FileMeta]> segments;

    spacing: 4px;
    padding: 0px;

    Rectangle {
        height: 22px;
        background: #e1e0d9;
        border-radius: 6px;
        clip: true;

        HorizontalLayout {
            padding: 0px;
            spacing: 2px;

            for seg in segments: Rectangle {
                horizontal-stretch: max(1, seg.size);
                background: seg.color;
            }

            if cap > used: Rectangle {
                horizontal-stretch: max(0, cap - used);
                background: transparent;
            }
        }
    }

    HorizontalLayout {
        padding: 0px;
        Text {
            text: used-text;
            color: #52514e;
            font-size: 11px;
            horizontal-alignment: left;
        }
        Text {
            text: "of " + cap-text;
            color: #52514e;
            font-size: 11px;
            horizontal-alignment: right;
        }
    }
}

// ---------------------------------------------------------------------------
// DiskFileCard: row representation of a file in the disk pane
// ---------------------------------------------------------------------------

component DiskFileCard inherits Rectangle {
    in property <FileMeta> meta;

    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-disk(string);

    background: #fffdf8;
    border-color: #e1e0d9;
    border-width: 1px;
    border-radius: 8px;
    height: 36px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: meta.color;
        }

        // File name
        Text {
            text: meta.name;
            color: #24303a;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Formatted size
        Text {
            text: meta.size-formatted;
            color: #68747b;
            font-size: 12px;
            vertical-alignment: center;
        }

        // Action buttons
        ActionButton {
            text: "to db";
            clicked => { root.save-to-db(meta.id); }
        }
        ActionButton {
            text: "to cloud";
            clicked => { root.save-to-cloud(meta.id); }
        }
        ActionButton {
            text: "✕";
            danger: true;
            clicked => { root.delete-from-disk(meta.id); }
        }
    }
}

// ---------------------------------------------------------------------------
// FileCard: row representation of a file in a store pane
// ---------------------------------------------------------------------------

component FileCard inherits Rectangle {
    in property <FileMeta> meta;

    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);

    background: #fffdf8;
    border-color: #e1e0d9;
    border-width: 1px;
    border-radius: 8px;
    height: 36px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: meta.color;
        }

        // File name
        Text {
            text: meta.name;
            color: #24303a;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Formatted size
        Text {
            text: meta.size-formatted;
            color: #68747b;
            font-size: 12px;
            vertical-alignment: center;
        }

        // Action buttons
        ActionButton {
            text: "to disk";
            clicked => { root.persist-to-disk(meta.id); }
        }
        ActionButton {
            text: "to db";
            clicked => { root.save-to-db(meta.id); }
        }
        ActionButton {
            text: "to cloud";
            clicked => { root.save-to-cloud(meta.id); }
        }
        ActionButton {
            text: "✕";
            danger: true;
            clicked => { root.delete-from-ram(meta.id); }
        }
    }
}

// ---------------------------------------------------------------------------
// RamPane: full RAM tier pane
// ---------------------------------------------------------------------------

component RamPane inherits Rectangle {
    in property <string> used-text: "0 B";
    in property <string> cap-text: "10.0 MB";
    in property <int> used-bytes: 0;
    in property <int> cap-bytes: 10485760;
    in property <[FileMeta]> files;

    callback browse-ram();
    callback stream-to-disk();
    callback pull-the-plug();
    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);

    background: #fffdf8;
    border-color: #c9c1b4;
    border-width: 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "RAM";
                color: #24303a;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "volatile — cleared when app closes";
                color: #68747b;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Meter {
            used: used-bytes;
            cap: cap-bytes;
            used-text: used-text;
            cap-text: cap-text;
            segments: files;
        }

        Rectangle {
            height: 70px;
            background: drop-touch.has-hover ? #f4f1ea : #f9f9f7;
            border-width: 2px;
            border-color: drop-touch.has-hover ? #2a78d6 : #c3c2b7;
            border-radius: 10px;

            drop-touch := TouchArea {
                clicked => { root.browse-ram(); }
            }

            Text {
                text: files.length == 0 ? "drop files here or click to browse" : files.length + " file(s) in RAM";
                color: #898781;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Flickable {
            min-height: 100px;
            vertical-stretch: 1;
            viewport-height: files-layout.preferred-height;

            files-layout := VerticalLayout {
                spacing: 6px;
                for f in files: FileCard {
                    meta: f;
                    persist-to-disk(id) => { root.persist-to-disk(id); }
                    save-to-db(id) => { root.save-to-db(id); }
                    save-to-cloud(id) => { root.save-to-cloud(id); }
                    delete-from-ram(id) => { root.delete-from-ram(id); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            PaneButton {
                text: "Upload";
                primary: true;
                clicked => { root.browse-ram(); }
            }
            PaneButton {
                text: "Stream to disk";
                clicked => { root.stream-to-disk(); }
            }
            PaneButton {
                text: "Pull the plug";
                danger: true;
                clicked => { root.pull-the-plug(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// DiskPane: full disk tier pane
// ---------------------------------------------------------------------------

component DiskPane inherits Rectangle {
    in property <string> used-text: "0 B";
    in property <string> cap-text: "20.0 MB";
    in property <int> used-bytes: 0;
    in property <int> cap-bytes: 20971520;
    in property <[FileMeta]> segments;
    in property <[DiskFile]> files;
    in property <string> vault-path: "";

    callback reveal-vault();
    callback rescan-vault();
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-disk(string);

    background: #fffdf8;
    border-color: #c9c1b4;
    border-width: 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "DISK";
                color: #24303a;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "persistent — survives a restart";
                color: #68747b;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Meter {
            used: used-bytes;
            cap: cap-bytes;
            used-text: used-text;
            cap-text: cap-text;
            segments: segments;
        }

        Rectangle {
            height: 70px;
            background: #f9f9f7;
            border-width: 2px;
            border-color: #c3c2b7;
            border-radius: 10px;

            Text {
                text: files.length == 0 ? "drag from RAM to keep" : files.length + " file(s) on disk";
                color: #898781;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Flickable {
            min-height: 100px;
            vertical-stretch: 1;
            viewport-height: files-layout.preferred-height;

            files-layout := VerticalLayout {
                spacing: 6px;
                for f in files: DiskFileCard {
                    meta: f.meta;
                    save-to-db(id) => { root.save-to-db(id); }
                    save-to-cloud(id) => { root.save-to-cloud(id); }
                    delete-from-disk(id) => { root.delete-from-disk(id); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            PaneButton {
                text: "Open folder";
                clicked => { root.reveal-vault(); }
            }
            PaneButton {
                text: "Rescan";
                clicked => { root.rescan-vault(); }
            }
            Text {
                text: root.vault-path;
                color: #68747b;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// SinkFileCard: row representation of a file in a sink (DB/Cloud) panel.
// Named distinctly from the RAM pane's FileCard (different signature: a
// single delete-clicked callback rather than the four RAM tier actions).
// ---------------------------------------------------------------------------

component SinkFileCard inherits Rectangle {
    in property <FileMeta> meta;
    in property <string> delete-title: "Delete file";
    callback delete-clicked();

    background: #ffffff;
    border-color: #e1e0d9;
    border-width: 1px;
    border-radius: 8px;
    height: 36px;

    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        // Swatch
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: #008300;
        }

        // File name
        Text {
            text: meta.name;
            color: #0b0b0b;
            font-size: 12px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        // Size
        Text {
            text: meta.size-formatted;
            color: #898781;
            font-size: 11px;
            vertical-alignment: center;
        }

        // Delete button ✕
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 5px;
            border-width: 1px;
            border-color: #e1e0d9;
            background: touch.has-hover ? #e1e0d9 : transparent;

            Text {
                text: "✕";
                color: #52514e;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => { root.delete-clicked(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Database and Cloud compact sink panels. Ported from SinkPanel.tsx.
// ---------------------------------------------------------------------------

component SinkPanel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> connected;
    in property <int> used-bytes;
    in property <int> cap-bytes: 104857600;
    in property <string> used-text;
    in property <string> cap-text;
    in property <string> detail-text;
    in property <string> offline-message;
    in property <string> delete-title: "Delete file";
    in property <[FileMeta]> files;

    callback delete-file(string);

    background: #fffdf8;
    border-color: #c9c1b4;
    border-width: 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        // Header: Title and Subtitle
        HorizontalBox {
            spacing: 8px;
            padding: 0px;
            Text {
                text: title;
                color: #24303a;
                font-size: 14px;
                font-weight: 700;
            }
            Text {
                text: subtitle;
                color: #68747b;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Offline state
        if !connected : Rectangle {
            background: #e1e0d9;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;

                Text {
                    text: offline-message != "" ? offline-message : "offline";
                    color: #52514e;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Online state
        if connected : VerticalBox {
            padding: 0px;
            spacing: 8px;

            // Segmented Meter Track (100 MB cap visualization)
            Rectangle {
                height: 22px;
                background: #e1e0d9;
                border-radius: 6px;
                clip: true;

                if used-bytes > 0 : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * Math.max(0.01, Math.min(1.0, (used-bytes * 1.0) / (cap-bytes * 1.0)));
                    height: 100%;
                    background: #008300;
                }
            }

            // Meter Caption
            HorizontalBox {
                padding: 0px;
                Text {
                    text: used-text;
                    color: #52514e;
                    font-size: 11px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "of " + cap-text;
                    color: #52514e;
                    font-size: 11px;
                }
            }

            // Physical Note / Extra Detail
            if detail-text != "" : Text {
                text: detail-text;
                color: #898781;
                font-size: 11px;
            }

            // File List
            if files.length == 0 : Text {
                text: "No files stored in this tier yet";
                color: #898781;
                font-size: 11px;
            }

            if files.length > 0 : ScrollView {
                max-height: 220px;
                VerticalLayout {
                    spacing: 6px;
                    for f in files : SinkFileCard {
                        meta: f;
                        delete-title: root.delete-title;
                        delete-clicked => { root.delete-file(f.id); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Sparkline: bar-style time series. One thin Rectangle per history point, each
// bar's height bound to `parent.height * (value / max-value)`. This is the Slint
// replacement for the React SVG line sparkline — Slint's `Path` cannot hold a
// `for` loop, so a real bar sparkline out of layout Rectangles it is. The `rss`
// field is shown when `show-rss` is set, otherwise `ram`.
// ---------------------------------------------------------------------------

component Sparkline inherits Rectangle {
    in property <[HistoryPoint]> points;
    in property <int> max-value: 1;
    in property <bool> show-rss: false;
    in property <color> bar-color: #2a78d6;

    height: 64px;
    background: #fffdf8;
    border-color: #e1e0d9;
    border-width: 1px;
    border-radius: 6px;
    clip: true;

    HorizontalLayout {
        padding: 4px;
        spacing: 1px;

        for point in points: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Bar height as a fraction of the track; a transparent spacer sits
            // above it so bars grow up from the baseline like a real sparkline.
            property <length> bar-height: parent.height * ((show-rss ? point.rss : point.ram) * 1.0 / max-value);

            Rectangle {
                height: max(0px, parent.height - bar-height);
            }

            Rectangle {
                height: bar-height;
                background: bar-color;
                border-radius: 1px;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Instruments: the collapsible dashboard drawer. Two stacked time-series charts
// — RAM store bytes and process RSS — each with its own y-scale, sharing the
// same x-axis (the 4 Hz history buffer). Deliberately two charts, never one
// plot with two y-axes (the hard rule from CLAUDE.md). Plus the file table.
// ---------------------------------------------------------------------------

component Instruments inherits VerticalBox {
    in property <[HistoryPoint]> history;
    in property <int> ram-max: 10485760;
    in property <int> rss-max: 1;
    in property <string> ram-series-label: "RAM store bytes (0–10 MB)";
    in property <string> rss-series-label: "Process RSS (whole tree, auto-scaled)";
    in property <string> axis-note: "Two separate scales, deliberately never combined on one axis — see docs/03-ui-and-visualization.md.";
    in property <[FileTableRow]> table-rows;

    property <bool> open: false;

    spacing: 4px;

    Rectangle {
        height: 32px;
        border-radius: 6px;
        background: touch.has-hover ? #e1e0d9 : transparent;

        touch := TouchArea {
            clicked => { open = !open; }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;

            Text {
                text: open ? "▾ Instruments — time series · file table" : "▸ Instruments — time series · file table";
                color: #24303a;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    if open : VerticalBox {
        spacing: 6px;

        Text {
            text: ram-series-label;
            color: #68747b;
            font-size: 11px;
        }
        Sparkline {
            points: history;
            max-value: ram-max;
            bar-color: #2a78d6;
        }

        Text {
            text: rss-series-label;
            color: #68747b;
            font-size: 11px;
        }
        Sparkline {
            points: history;
            max-value: rss-max;
            show-rss: true;
            bar-color: #eb6834;
        }

        Text {
            text: axis-note;
            color: #9a9386;
            font-size: 11px;
        }

        Rectangle {
            background: #fffdf8;
            border-color: #e1e0d9;
            border-width: 1px;
            border-radius: 6px;
            height: 200px;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                HorizontalLayout {
                    Text { text: "Name"; color: #52514e; font-size: 11px; font-weight: 600; horizontal-stretch: 3; overflow: elide; }
                    Text { text: "Size"; color: #52514e; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "Tier"; color: #52514e; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "Mime"; color: #52514e; font-size: 11px; font-weight: 600; horizontal-stretch: 2; overflow: elide; }
                }

                if table-rows.length == 0 : Text {
                    text: "no files in any tier yet";
                    color: #898781;
                    font-size: 11px;
                }

                if table-rows.length > 0 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 2px;

                        for row in table-rows: HorizontalLayout {
                            Text { text: row.name; color: #24303a; font-size: 12px; horizontal-stretch: 3; vertical-alignment: center; overflow: elide; }
                            Text { text: row.size-formatted; color: #68747b; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: row.tier; color: #68747b; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: row.mime; color: #68747b; font-size: 12px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The shell.
// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Ephemera — RAM vs Disk vs Database vs Cloud";
    width: 1280px;
    height: 860px;
    background: #f4f1ea;

    // ---- State model: mirrors src/store/useAppStore.ts -------------------
    in-out property <string> vault-path: "";
    in-out property <[FileMeta]> ram-files;
    in-out property <[DiskFile]> disk-files;
    in-out property <[DbFile]> db-files;
    in-out property <[CloudFile]> cloud-files;
    in-out property <Metrics> metrics: {
        ts: "",
        ram-store-bytes: 0,
        ram-cap: 10485760,
        disk-store-bytes: 0,
        disk-cap: 20971520,
        db-store-bytes: 0,
        db-cap: 104857600,
        db-physical-bytes: 0,
        cloud-store-bytes: 0,
        cloud-cap: 104857600,
        process-rss-bytes: 0,
        process-count: 1,
    };
    in-out property <DbStatus> db-status: {
        connected: false,
        logical-bytes: 0,
        physical-bytes: 0,
        cap: 104857600,
        message: "",
    };
    in-out property <CloudStatus> cloud-status: {
        connected: false,
        bytes-used: 0,
        cap: 104857600,
        bucket: "",
        message: "",
    };

    in-out property <[FileMeta]> db-meta-files;
    in-out property <[FileMeta]> cloud-meta-files;
    // FileMeta display projection of the disk list (the disk pane's meter binds
    // segments against these; the full DiskFile model above stays the state).
    in-out property <[FileMeta]> disk-meta-files;

    in-out property <string> ram-used-text: "0 B";
    in-out property <string> ram-cap-text: "10.0 MB";
    in-out property <string> ram-count-text: "0 files in RAM";
    in-out property <string> disk-used-text: "0 B";
    in-out property <string> disk-cap-text: "20.0 MB";
    in-out property <string> disk-count-text: "0 files on disk";
    in-out property <string> app-memory-text: "0 B";
    in-out property <string> app-memory-caption: "process tree, approximated";
    in-out property <string> files-text: "0 / 0";
    in-out property <string> files-caption: "ram / disk";
    in-out property <string> db-used-text: "0 B";
    in-out property <string> db-cap-text: "100.0 MB";
    in-out property <string> db-count-text: "0 files in database";
    in-out property <string> db-detail-text: "database: not connected";
    in-out property <string> cloud-used-text: "0 B";
    in-out property <string> cloud-cap-text: "100.0 MB";
    in-out property <string> cloud-count-text: "0 files in cloud";
    in-out property <string> cloud-detail-text: "cloud: not connected";
    in-out property <int> history-len: 0;
    // Projection of the Rust-side 240-point ring buffer (see model.rs
    // `MetricPoint` / `ShellState.history`) into the two stacked sparklines.
    in-out property <[HistoryPoint]> history;
    in-out property <int> rss-max: 1;
    in-out property <string> rss-series-label: "Process RSS (whole tree, auto-scaled)";
    in-out property <[FileTableRow]> file-table-rows;
    in-out property <string> error-message: "";

    // Slint → Rust: delete actions from sink panels
    callback delete-db-file(string);
    callback delete-cloud-file(string);

    // Slint → Rust: the placeholder "refresh everything" action. Rust handles it
    // with direct ephemera-core calls — the old `refreshAll` zustand action had
    // to cross IPC, this one does not.
    callback refresh-all();
    callback upload-ram-files();
    callback stream-upload-to-disk();
    callback flush-ram();
    callback persist-to-disk(string);
    callback save-to-db(string);
    callback save-to-cloud(string);
    callback delete-from-ram(string);
    callback reveal-vault();
    callback rescan-vault();
    callback save-disk-to-db(string);
    callback save-disk-to-cloud(string);
    callback delete-from-disk(string);
    callback clear-error();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        if root.error-message != "": Rectangle {
            background: #fde8e8;
            border-width: 1px;
            border-color: #d03b3b;
            border-radius: 8px;
            height: 38px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: root.error-message;
                    color: #d03b3b;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                ActionButton {
                    text: "✕";
                    danger: true;
                    clicked => { root.clear-error(); }
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            Text {
                text: "Ephemera";
                color: #24303a;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: "vault: " + root.vault-path;
                color: #68747b;
                font-size: 14px;
                vertical-alignment: center;
            }
            Button {
                text: "Refresh";
                clicked => { root.refresh-all(); }
            }
        }

        HorizontalBox {
            StatTile {
                tile-label: "RAM USED";
                tile-value: root.ram-used-text;
                tile-caption: "of " + root.ram-cap-text;
            }
            StatTile {
                tile-label: "DISK USED";
                tile-value: root.disk-used-text;
                tile-caption: "of " + root.disk-cap-text;
            }
            StatTile {
                tile-label: "APP MEMORY";
                tile-value: root.app-memory-text;
                tile-caption: root.app-memory-caption;
            }
            StatTile {
                tile-label: "FILES";
                tile-value: root.files-text;
                tile-caption: root.files-caption;
            }
        }

        HorizontalBox {
            RamPane {
                used-text: root.ram-used-text;
                cap-text: root.ram-cap-text;
                used-bytes: root.metrics.ram-store-bytes;
                cap-bytes: root.metrics.ram-cap;
                files: root.ram-files;

                browse-ram => { root.upload-ram-files(); }
                stream-to-disk => { root.stream-upload-to-disk(); }
                pull-the-plug => { root.flush-ram(); }
                persist-to-disk(id) => { root.persist-to-disk(id); }
                save-to-db(id) => { root.save-to-db(id); }
                save-to-cloud(id) => { root.save-to-cloud(id); }
                delete-from-ram(id) => { root.delete-from-ram(id); }
            }
            DiskPane {
                used-text: root.disk-used-text;
                cap-text: root.disk-cap-text;
                used-bytes: root.metrics.disk-store-bytes;
                cap-bytes: root.metrics.disk-cap;
                segments: root.disk-meta-files;
                files: root.disk-files;
                vault-path: root.vault-path;

                reveal-vault => { root.reveal-vault(); }
                rescan-vault => { root.rescan-vault(); }
                save-to-db(id) => { root.save-disk-to-db(id); }
                save-to-cloud(id) => { root.save-disk-to-cloud(id); }
                delete-from-disk(id) => { root.delete-from-disk(id); }
            }
        }

        HorizontalBox {
            SinkPanel {
                title: "DATABASE";
                subtitle: "postgres (docker)";
                connected: root.db-status.connected;
                used-bytes: root.db-status.logical-bytes;
                cap-bytes: root.db-status.cap;
                used-text: root.db-used-text;
                cap-text: root.db-cap-text;
                detail-text: root.db-detail-text;
                offline-message: root.db-status.message != "" ? root.db-status.message : "Database offline — start it with docker compose up -d";
                delete-title: "Delete from database";
                files: root.db-meta-files;
                delete-file(id) => { root.delete-db-file(id); }
            }
            SinkPanel {
                title: "CLOUD";
                subtitle: "gcs bucket";
                connected: root.cloud-status.connected;
                used-bytes: root.cloud-status.bytes-used;
                cap-bytes: root.cloud-status.cap;
                used-text: root.cloud-used-text;
                cap-text: root.cloud-cap-text;
                detail-text: root.cloud-detail-text;
                offline-message: root.cloud-status.message != "" ? root.cloud-status.message : "GCS bucket offline or gcs-key.json missing";
                delete-title: "Delete from cloud";
                files: root.cloud-meta-files;
                delete-file(id) => { root.delete-cloud-file(id); }
            }
        }

        Instruments {
            history: root.history;
            ram-max: root.metrics.ram-cap;
            rss-max: root.rss-max;
            rss-series-label: root.rss-series-label;
            table-rows: root.file-table-rows;
        }
    }
}
