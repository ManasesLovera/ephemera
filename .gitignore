# Logs
logs
*.log

# Rust
**/target/
# ephemera-core is a library — its Cargo.lock isn't meaningful to commit.
# ephemera-app is the binary; its Cargo.lock IS committed (not ignored here).
/crates/ephemera-core/Cargo.lock

# Secrets — never commit
/crates/ephemera-app/.env
/crates/ephemera-app/gcs-key.json
*.pem
*.key

